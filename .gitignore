# Dados do usuário (aprendizado, histórico, logs): nunca vão para o repositório
memory/

# Chaves de API gravadas pela tela de Configurações: nunca vão para o repositório
.env

# Gerados pelo Python, pytest e PyInstaller
__pycache__/
*.pyc
.pytest_cache/
build/
dist/
*.spec
instalador/saida/

# Temporários
*.tmp
*.corrompido
*.log
scratch_*.py

# Artigos da Wikipédia guardados pela avaliação da IA (ferramentas/avaliar_ia.py)
ferramentas/.cache_avaliacao/
